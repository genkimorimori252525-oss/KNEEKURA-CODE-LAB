{
  "name": "kneekura-code-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft/Forge aware code graph laboratory for private repository analysis.",
  "exports": {
    "./plugin": "./src/plugin.mjs",
    "./mailbox": "./src/mailbox.mjs",
    "./ask-graph": "./src/ask-graph.mjs",
    "./human-analysis": "./src/human-analysis/index.mjs",
    "./human-experience": "./src/human-experience/index.mjs",
    "./skill": "./src/skill/index.mjs"
  },
  "scripts": {
    "scan": "node src/cli.mjs scan",
    "serve": "node src/cli.mjs serve",
    "test": "node --test",
    "self-audit": "node scripts/self-audit.mjs",
    "demo": "node src/cli.mjs scan fixtures/forge-mini --out dist/graph.json && node src/cli.mjs serve --graph dist/graph.json",
    "presentation:guard": "node scripts/check-presentation-boundary.mjs",
    "test:presentation-p0": "node --test test/human-presentation-v2-p0.test.mjs",
    "test:presentation-p1": "node --test test/human-presentation-v2-p1.test.mjs",
    "explorer:dev": "vite --config packages/human-explorer/vite.config.mjs",
    "explorer:build": "vite build --config packages/human-explorer/vite.config.mjs",
    "test:presentation-p2": "node --test test/human-presentation-v2-p2.test.mjs",
    "test:presentation-p3": "node --test test/human-presentation-v2-p3.test.mjs",
    "test:presentation-p4": "node --test test/human-presentation-v2-p4.test.mjs",
    "test:presentation-guided-tour": "node --test test/human-presentation-v2-guided-tour.test.mjs",
    "test:presentation-change-impact": "node --test test/human-presentation-v2-change-impact.test.mjs",
    "test:presentation-ask-graph": "node --test test/human-presentation-v2-ask-graph.test.mjs",
    "test:presentation-confidence-evidence": "node --test test/human-presentation-v2-confidence-evidence.test.mjs",
    "test:ai-human-analysis-contract": "node --test test/ai-assisted-human-analysis-contract.test.mjs",
    "validate:love-github-typescript-live": "node scripts/validate-love-github-typescript-live.mjs",
    "validate:love-github-human-guide-live": "node scripts/validate-love-github-human-guide-live.mjs",
    "validate:love-github-human-guide-production-r1": "node scripts/run-love-github-human-guide-production-r1.mjs",
    "validate:love-github-system-map-r2": "node scripts/validate-love-github-system-map-r2.mjs",
    "validate:love-github-human-guide-production-r3": "node scripts/run-love-github-human-guide-production-r3.mjs",
    "validate:love-github-human-guide-production-r4": "node scripts/run-love-github-human-guide-production-r4.mjs",
    "validate:love-github-human-guide-production-r5": "node scripts/validate-love-github-human-guide-production-r5.mjs",
    "validate:archify-native": "node scripts/validate-kneekura-code-lab-archify-native.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xyflow/react": "12.11.5",
    "elkjs": "0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "@typescript/typescript6": "6.0.2"
  }
}