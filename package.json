{
  "name": "kneekura-code-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minecraft/Forge aware code graph laboratory for private repository analysis.",
  "exports": {
    "./plugin": "./src/plugin.mjs",
    "./mailbox": "./src/mailbox.mjs"
  },
  "scripts": {
    "scan": "node src/cli.mjs scan",
    "serve": "node src/cli.mjs serve",
    "test": "node --test",
    "self-audit": "node scripts/self-audit.mjs",
    "demo": "node src/cli.mjs scan fixtures/forge-mini --out dist/graph.json && node src/cli.mjs serve --graph dist/graph.json",
    "presentation:guard": "node scripts/check-presentation-boundary.mjs",
    "test:presentation-p0": "node --test test/human-presentation-v2-p0.test.mjs",
    "test:presentation-p1": "node --test test/human-presentation-v2-p1.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
